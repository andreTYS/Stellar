# Copia este archivo a .env y edítalo.
#   cp .env.ejemplo .env
#   openssl rand -hex 16     para generar cada contraseña

# ── Base de datos ────────────────────────────────────────────
DB_ROOT_PASS=cambia-esto
DB_NAME=innovasteam
DB_USER=innovasteam
DB_PASS=cambia-esto-tambien

# ── Dominio ──────────────────────────────────────────────────
DOMINIO=innovasteam.moqueguasoft.com

# ── Traefik ──────────────────────────────────────────────────
# La red externa donde ya vive tu Traefik. Compruébala con:
#   docker inspect <tu-traefik> --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}'
TRAEFIK_RED=proxy

# El entrypoint y el resolver TLS, tal como los llama TU Traefik.
# OJO: si el resolver no coincide con uno que exista en su
# configuración, Traefik descarta el router entero y el dominio
# responde 404, con este error en su log:
#   "Router uses a nonexistent certificate resolver"
# Compruébalo con:
#   docker inspect <tu-traefik> --format '{{json .Config.Cmd}}' | tr ',' '\n' | grep -i certificatesresolvers
TRAEFIK_ENTRADA=websecure
TRAEFIK_RESOLVER=letsencrypt

# Puerto en el loopback del VPS, solo para comprobar con curl desde el
# propio servidor. No queda expuesto a internet.
PUERTO=8080

# ── Comportamiento ───────────────────────────────────────────
# true en una demostración pública: bloquea cambiar contraseñas y
# desactivar cuentas de prueba. false en un colegio de verdad.
MODO_DEMO=true

# Solo si vas a usar el asistente de estudio. Sin esto, la plataforma
# se niega a guardar claves de API en vez de guardarlas en claro.
#   openssl rand -hex 32
CHATBOT_CLAVE_MAESTRA=

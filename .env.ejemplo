# Copia este archivo a .env y cambia las contraseñas.
#   cp .env.ejemplo .env
#   php -r "echo bin2hex(random_bytes(16)).PHP_EOL;"   # para generarlas

DB_ROOT_PASS=cambia-esto
DB_NAME=innovasteam
DB_USER=innovasteam
DB_PASS=cambia-esto-tambien

# Puerto del VPS en el que escucha la plataforma. Tu proxy apunta aquí.
PUERTO=8080

# true en una demostración pública: bloquea cambiar contraseñas y
# desactivar cuentas de prueba. false en un colegio de verdad.
MODO_DEMO=true

# Solo si vas a usar el asistente de estudio. Sin esto, la plataforma
# se niega a guardar claves de API en vez de guardarlas en claro.
#   php -r "echo bin2hex(random_bytes(32)).PHP_EOL;"
CHATBOT_CLAVE_MAESTRA=
